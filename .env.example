# Copy to a protected runtime environment (or a private .env file) and replace every placeholder.
# Never commit a populated .env file or expose it through the public web root.

# Public site origin used for canonical, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=https://faisalhossen.com

# Existing Hostinger MariaDB connection. URL-encode reserved characters in the password.
DATABASE_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/DB_NAME
# Use true only if the hosting provider requires TLS; certificate validation remains enabled.
DATABASE_SSL=false

# Absolute writable path outside public/ and outside versioned release directories.
# Create it first and keep it persistent across deployments.
MEDIA_STORAGE_DIR=/home/your-hosting-user/faisals-room-media

# Keep public content on the checked-in files until parity and rollback are verified.
CONTENT_SOURCE=files

# Generate with: openssl rand -hex 32
# Keep this secret private and do not reuse an account password.
APP_SECURITY_SECRET=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_SECRET

# The owner account has already been bootstrapped. Keep these unset in steady state.
# Only set temporarily if you are intentionally provisioning a fresh installation.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Optional Resend delivery. Contact records persist even if notifications are disabled.
RESEND_API_KEY=
CONTACT_EMAIL=info@faisalhossen.com
# Must be an email/domain verified with Resend before enabling delivery.
CONTACT_FROM_EMAIL=

# Do not set PORT or HOSTNAME manually under LiteSpeed Passenger; it manages the listener.
