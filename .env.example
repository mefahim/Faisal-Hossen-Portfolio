# Public origin used for canonical, sitemap, and social metadata. Replace with the verified production origin.
NEXT_PUBLIC_SITE_URL=https://example.com

# Phase 1 private control center. Provision MySQL 8.0+ before running migrations.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Set true only when the database provider requires TLS; certificate validation remains enabled.
DATABASE_SSL=false
# Keep media outside public/. Production must use a durable path that survives application releases.
MEDIA_STORAGE_DIR=/absolute/persistent/path/faisals-room-media
# Keep verified file-backed public content active until the seed has been checked and reviewed.
CONTENT_SOURCE=files
# Generate a cryptographically random secret with at least 32 characters; do not reuse a password.
APP_SECURITY_SECRET=replace-with-a-random-32-character-or-longer-secret
# Set temporarily only for the one-time owner bootstrap command; remove both after it succeeds.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Optional contact email notification. Contact submissions are stored even when these are unset.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
